{%- comment -%}
  픽셀 윤슬 히어로 (2026-10-21) — 콜라주 판(web/theme_collage_2026-10-20)에서 첫 화면만 다른 컨셉으로 바꿈. 상품 영역·스크롤 동작은 그대로.
  - 2026-10-21 하루 사이클: 11시·노을·밤 그림을 12초에 한 바퀴 섞음, 해가 움직임, 낮 = 여자 모델 / 노을~밤 = 남자 모델. &dnr_tod=day|sunset|night 이면 멈춤
  - 2026-10-21 3차: 배경을 혜선이 준 강가 사진(윤슬·라일락 들꽃)을 참고 이미지 색감으로 보정해 픽셀화한 것으로. 칸 = 2차의 절반. 물결 고리 모션 뺌 → 윤슬 반짝임. 글자는 1~2개씩 타자. 모델은 하늘하늘 부유
  - 배경(1·2차): 정사각 칸 모자이크(참고 이미지 구도: 위 = 가로 물결 띠, 아래 = 세로 줄기) + 거친 입자. 색 = 참고 이미지(강가 사진 픽셀화) 분석 — 위 하늘·물 연한 하늘색, 가운데 윤슬 흰 띠, 아래 강가 풀 연두·초록, 드물게 라일락
  - 움직임: 물결이 흐르며 칸 색이 계단식으로 바뀜(약 8fps), 밝은 칸이 윤슬처럼 반짝, 마우스·손가락 자리에서 물결 고리가 퍼짐, 입자 두 장 번갈아
  - 글자 표지: About 페이지 문장에서 골라 ■ 표지와 함께 흩어 놓음(일부 세로). 대문자 전체 표기 금지 정책 → 소문자. 모두 모델 뒤
  - 모델 사진(dnr-collage-person.webp)은 콜라주 판과 같은 자리·같은 움직임(떠다님, 클릭하면 흔들림). 콜라주 조각·검정 레이어는 뺌
  - 콜라주 판 원본 = sections/dnr-dense-home.v0_from_collage.liquid
{%- endcomment -%}
{%- liquid
  assign coll = collections[section.settings.collection]
  if coll == blank
    assign coll = collections['all']
  endif
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&display=swap">
<style>
  body:has(.dnr-dense) { background: #f2f2f0; }
  .dnr-dense { --paper:#f2f2f0; --ink:#16191c; --soft:#6b6f72; --mono:'IBM Plex Mono',ui-monospace,Menlo,monospace; color: var(--ink); background: var(--paper); }
  .dnr-dense__hero { position: relative; }
  .dnr-dense__hero canvas { display: block; width: 100%; touch-action: pan-y; }
  .dnr-dense__cap { display: flex; justify-content: space-between; padding: 10px 16px 0; font: 500 11px/1.4 var(--mono); color: var(--soft); }

  /* ---------- 콜라주: 조각마다 데스크톱(--x --y --w --r)·모바일(--mx --my --mw --mr --mz) 좌표, 값은 첫 화면 가로·세로 % ---------- */
  .dnr-dense__art { position: relative; overflow: hidden; }
  .dnr-collage { position: absolute; inset: 0; pointer-events: none; }
  .dnr-pc { --X: var(--x); --Y: var(--y); --W: var(--w); --R: var(--r);
    position: absolute; left: var(--X); top: var(--Y); width: var(--W); height: auto; max-width: none; rotate: var(--R); z-index: var(--z);
    translate: var(--px, 0px) var(--py, 0px); transition: translate .7s cubic-bezier(.2,.7,.2,1);
    filter: drop-shadow(0 1px 1.5px rgba(30,22,12,.28)) drop-shadow(0 10px 16px rgba(30,22,12,.18)); user-select: none; -webkit-user-drag: none; will-change: transform; }
  .dnr-dense .dnr-pc--person { animation: none !important; transition: none; }   /* 하루 사이클: 여자·남자 모델이 투명도로 바뀜(2026-10-21) */
  .dnr-dense .dnr-pc--man { opacity: 0; }
  .dnr-pc--person { width: auto; --H: var(--h); height: var(--H); filter: drop-shadow(0 2px 2px rgba(30,22,12,.3)) drop-shadow(0 18px 26px rgba(30,22,12,.22)); }
  @media (max-width: 749px){
    .dnr-pc { --X: var(--mx); --Y: var(--my); --W: var(--mw); --R: var(--mr); z-index: var(--mz, var(--z)); }
    .dnr-pc--person { --H: var(--mh); }
    .dnr-pc[data-mobile="off"] { display: none; }
  }
  /* ---------- 글자 표지(픽셀 윤슬 판): 데스크톱 --x --y, 모바일 --mx --my (첫 화면 가로·세로 %). .v = 세로(아래에서 위로 읽힘) ---------- */
  .dnr-labs { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .dnr-lab { position: absolute; left: var(--x); top: var(--y); display: flex; align-items: center; gap: 8px; white-space: nowrap;
    font: 500 13px/1.25 var(--font-body-family, 'DM Sans', sans-serif); letter-spacing: .01em; color: var(--lab-ink, #16191c); }
  .dnr-lab::before { content: ''; flex: none; width: 10px; height: 10px; background: var(--lab-ink, #16191c); }
  .dnr-lab.v { writing-mode: vertical-rl; transform: rotate(180deg); }
  .dnr-lab.two { white-space: normal; width: max-content; max-width: 22em; align-items: flex-start; }
  .dnr-lab.two::before { margin-top: .2em; }
  /* 타자: 차례가 오기 전에는 표지째 숨김. 찍는 동안·직후에는 글 끝에 검은 막대 커서 */
  .dnr-lab:not(.on) { visibility: hidden; }
  .dnr-lab .tx { font-style: normal; white-space: pre-line; }
  .dnr-lab.typing::after, .dnr-lab.blink::after { content: ''; flex: none; width: .5em; height: 1.05em; margin-left: -4px; background: var(--lab-ink, #16191c); }
  .dnr-lab.blink::after { animation: dnrBlink .5s steps(1) infinite; }
  @media (max-width: 749px){
    .dnr-lab { left: var(--mx); top: var(--my); font-size: 11px; gap: 6px; }
    .dnr-lab::before { width: 8px; height: 8px; }
    .dnr-lab[data-mobile="off"] { display: none; }
  }
  /* 붙여지듯 하나씩: 살짝 크고 더 기운 채로 내려앉음 */
  .dnr-collage:not(.go) .dnr-pc { opacity: 0; }
  .dnr-collage.go .dnr-pc { animation: dnrStick .75s cubic-bezier(.2,.85,.25,1.12) both; animation-delay: calc(var(--i) * 75ms + 120ms); }
  @keyframes dnrStick { from { opacity: 0; scale: 1.07; rotate: calc(var(--R) + 5deg); } 40% { opacity: 1; } to { opacity: 1; scale: 1; rotate: var(--R); } }
  @media (prefers-reduced-motion: reduce){ .dnr-collage.go .dnr-pc { animation: none; } .dnr-pc { transition: none; } }

  .dnr-dense__field { position: sticky; top: 0; height: 100svh; margin-bottom: -100svh; pointer-events: none; }
  .dnr-dense__field canvas { width: 100%; height: 100%; display: block; }
  .dnr-dense__items { position: relative; }
  /* 상품 한 벌 = 화면 1.7개 높이. 무대는 화면 가운데 고정, 내리는 동안 정면 → 착용샷(카드 호버 사진) */
  .dnr-dense__item { height: calc(123svh - 44px); }   /* 2026-10-20 사진 위 타이틀 뺀 만큼(-52px) → 170svh → 145svh → 한 번 더 15%↓ (웹·모바일 같음) */
  /* 모바일(2026-10-20): 첫 상품이 히어로에 10svh 더 가깝게.
     위로 당긴 만큼 무대(빈 부분)가 히어로 아래쪽에 겹치므로 무대는 클릭을 통과시키고 옷·설명만 받음 */
  @media (max-width: 749px) {
    .dnr-dense__field { margin-bottom: -110svh; }   /* 상품 줄을 10svh 위로 (items에 음수 margin-top을 주면 이 -100svh와 겹쳐 사라짐) */
    .dnr-dense__items, .dnr-dense__item, .dnr-dense__stage { pointer-events: none; }
    .dnr-dense__obj, .dnr-dense__all { pointer-events: auto; }   /* 옷 링크·see all은 그대로 눌림 (설명은 .is-on일 때 따로 켜짐) */
  }
  .dnr-dense__stage { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; padding-top: 60px; box-sizing: border-box; }   /* 위에 떠 있는 헤더(60px)만큼 내림 */
  .dnr-dense__stage { --shift: 20vw; }
  @media (min-width: 750px) { .dnr-dense__stage { --shift: min(17vw, 250px); } }
  /* 옷(+이름표)이 가운데 → 왼쪽으로. --m: 0~1 (스크롤 진행) */
  .dnr-dense__obj { display: grid; justify-items: center; gap: 14px; text-decoration: none; color: var(--ink);
    transform: translateX(calc(var(--m, 0) * -1 * var(--shift))) scale(calc(1 - var(--m, 0) * .16)); will-change: transform; }
  .dnr-dense__obj .dnr-dense__label { opacity: calc(1 - var(--m, 0)); }
  /* 오른쪽 설명: 터미널처럼 한 줄씩 찍힘 */
  .dnr-dense__desc { position: absolute; top: 50%; left: calc(50% + var(--shift) * .25); transform: translateY(-50%); width: min(42vw, 330px);
    font: 500 12px/1.75 var(--mono); color: var(--ink); opacity: var(--d, 0); pointer-events: none; }
  @media (min-width: 750px) { .dnr-dense__desc { font-size: 14px; left: calc(50% + var(--shift) * .1); } }
  .dnr-dense__desc.is-on { pointer-events: auto; }
  .dnr-dense__desc p { margin: 0; white-space: pre-wrap; min-height: 1.75em; }
  .dnr-dense__desc .h { font: 700 15px/1.4 var(--mono); margin-bottom: 6px; }
  @media (min-width: 750px) { .dnr-dense__desc .h { font-size: 18px; } }
  .dnr-dense__desc .cur { display: inline-block; width: .6em; height: 1.05em; background: #e3412b; vertical-align: -.15em; margin-left: 1px; }
  .dnr-dense__desc a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink); }
  .dnr-dense__pic { position: relative; width: min(77.4vw, 460px, calc((100svh - 160px) * .8));   /* 2026-10-20 두 번 10%씩 키움 (처음: 64vw, 380px) */ aspect-ratio: 4 / 5; max-width: 100%; }
  /* 사진은 JS가 실루엣대로 오려 캔버스로 바꿔 끼움 → 사각 테두리 없이 누끼처럼 */
  .dnr-dense__pic img, .dnr-dense__pic canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .dnr-dense__pic .p { opacity: calc(1 - var(--w, 0)); }
  .dnr-dense__pic .w.full { inset: auto; left: 50%; top: 50%; width: 118%; height: min(172%, calc(100svh - 110px)); transform: translate(-50%, -50%); object-fit: contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 94%, transparent 100%) !important; mask-image: linear-gradient(to bottom, #000 0, #000 94%, transparent 100%) !important; }
  .dnr-dense__pic .w { opacity: var(--w, 0); -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 88%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 88%, transparent 100%); }
  .dnr-dense__label { text-align: center; font: 500 12px/1.5 var(--mono); background: var(--paper); padding: 4px 10px; }
  .dnr-dense__label b { display: block; font: 600 14px/1.4 var(--dnr-pretendard, sans-serif); }
  /* 이름표 타자: .tx를 왼쪽부터 --k(0~1)만큼만 보이게, 커서는 그 끝에 */
  .dnr-dense__label .ty { display: block; }
  .dnr-dense__label .tw { display: inline-block; position: relative; }
  .dnr-dense__label .tx { display: inline-block; clip-path: inset(-2px calc((1 - var(--k, 1)) * 100%) -2px -2px); }
  .dnr-dense__label .tw.typing::after, .dnr-dense__label .tw.blink::after { content: ''; position: absolute; left: calc(var(--k, 1) * 100%); top: 50%; width: .55em; height: 1.05em; transform: translateY(-50%); margin-left: 1px; background: #e3412b; }
  .dnr-dense__label .tw.blink::after { animation: dnrBlink .5s steps(1) infinite; }
  @keyframes dnrBlink { 50% { opacity: 0; } }
  /* 맨 위로 (첫 화면을 지나면 나타남) */
  .dnr-dense__top { position: fixed; right: 14px; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); z-index: 30; font: 600 12px/1 var(--mono); color: var(--ink);
    background: var(--paper); border: 1px solid var(--ink); padding: 9px 11px; cursor: pointer; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; pointer-events: none; }
  .dnr-dense__top.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .dnr-dense__all { display: flex; justify-content: center; padding: 8px 16px 72px; position: relative; }
  .dnr-dense__all a { font: 500 13px var(--mono); color: var(--ink); border: 1px solid var(--ink); padding: 10px 18px; text-decoration: none; background: var(--paper); }
</style>

<div class="dnr-dense">
  <section class="dnr-dense__hero" aria-label="물빛 픽셀 위에서 싱글렛을 입고 스트레칭하는 러너">
    <div class="dnr-dense__art" id="dnrStage">
      <canvas id="dnrArt" aria-hidden="true"></canvas>
      <div class="dnr-labs" id="dnrLabs" aria-hidden="true">
        {%- comment -%} About 페이지 문장. 위치는 첫 화면 %, 모바일 값이 없으면 모바일에서 숨김 {%- endcomment -%}
        <span class="dnr-lab" style="--x:4%;--y:11%;--mx:5%;--my:2.5%">i do nut run for something.</span>
        <span class="dnr-lab" data-mobile="off" style="--x:71%;--y:11%">running wear for people who just run.</span>
        <span class="dnr-lab" style="--x:20%;--y:30%;--mx:66%;--my:2.5%">we run to run.</span>
        <span class="dnr-lab" style="--x:4%;--y:45%;--mx:5%;--my:9%">some run to feel the wind.</span>
        <span class="dnr-lab" data-mobile="off" style="--x:73%;--y:34%">some run to move their body.</span>
        <span class="dnr-lab v" style="--x:33%;--y:50%;--mx:3%;--my:36%">a hill worth climbing</span>
        <span class="dnr-lab two" style="--x:72%;--y:55%;--mx:52%;--my:9%">sometimes having no reason<br>is reason enough to run.</span>
        <span class="dnr-lab" data-mobile="off" style="--x:6%;--y:68%">for everyone who starts to run</span>
        <span class="dnr-lab v" style="--x:93%;--y:66%;--mx:93%;--my:30%">at their own pace</span>
        <span class="dnr-lab" data-mobile="off" style="--x:75%;--y:85%">today's run, out loud.</span>
        <span class="dnr-lab v" data-mobile="off" style="--x:26%;--y:44%">for when you run, and when you don't.</span>
        <span class="dnr-lab" data-mobile="off" style="--x:4%;--y:88%">some run just because.</span>
      </div>
      <div class="dnr-collage" id="dnrCollage">
        <img class="dnr-pc dnr-pc--person dnr-pc--woman" src="{{ 'dnr-pixel-woman.webp' | asset_url }}" alt="A runner stretching in a lavender singlet" width="906" height="2000" fetchpriority="high" style="--i:12;--d:.15;--z:5;--x:31.35%;--y:6%;--h:147%;--r:0deg;--mx:12.6%;--my:17%;--mh:116%;--mr:0deg">
        <img class="dnr-pc dnr-pc--person dnr-pc--man" src="{{ 'dnr-collage-person.webp' | asset_url }}" alt="A runner stretching in a clear sky singlet" width="945" height="2000" fetchpriority="high" style="--i:12;--d:.15;--z:5;--x:30.55%;--y:6%;--h:147%;--r:0deg;--mx:11%;--my:17%;--mh:116%;--mr:0deg">
      </div>
    </div>
    <div class="dnr-dense__cap"><span>ss26</span><span>set in do nut run</span></div>
  </section>

  <div class="dnr-dense__field" aria-hidden="true"><canvas id="dnrField"></canvas></div>
  <div class="dnr-dense__items">
    {%- for pass in (1..2) -%}
      {%- liquid
        if pass == 1
          assign want = 'air light'
        else
          assign want = 'air swift'
        endif
      -%}
    {%- for product in coll.products limit: 50 -%}
      {%- liquid
        assign parts = product.title | split: ' · '
        assign line_chk = parts[1] | downcase
        if line_chk != want
          continue
        endif
        assign pic = product.featured_image
        assign worn = blank
        for m in product.media
          assign msrc = m.preview_image.src | append: ''
          if msrc contains 'new_'
            if msrc contains '_b115' or msrc contains '_b215'
              assign pic = m.preview_image
            elsif msrc contains '_108' or msrc contains '_208'
              assign worn = m.preview_image
            endif
          endif
        endfor
        assign parts = product.title | split: ' · '
        assign gender = parts[2] | split: '(' | last | remove: ')'
        assign colour = parts[2] | split: ' (' | first
        assign line_d = parts[1] | downcase
        # 호버 사진(new_*_108/208)은 전신 사진을 잘라낸 것. 옆으로 비켜설 때는 같은 포즈의 전신 사진을 써서 위아래가 안 잘리게.
        # 원본 번호(2026-10-15 사진 대조): 남 al_cs 101 · al_hv 107 · as_cs 106 · as_hv 105 / 여 al_cs·al_hv·as_hv 207 · as_cs 201
        if line_d == 'air light'
          assign lc = 'al'
        else
          assign lc = 'as'
        endif
        if colour contains 'clear'
          assign cc = 'cs'
        else
          assign cc = 'hv'
        endif
        assign combo = lc | append: '_' | append: cc | append: '_' | append: gender
        case combo
          when 'al_cs_men'
            assign idx = '101'
          when 'al_hv_men'
            assign idx = '107'
          when 'as_cs_men'
            assign idx = '106'
          when 'as_hv_men'
            assign idx = '105'
          when 'as_cs_women'
            assign idx = '201'
          else
            assign idx = '207'
        endcase
        assign fkey = 'files/' | append: lc | append: '_' | append: cc | append: '_' | append: idx
        assign full = blank
        for m in product.media
          assign msrc = m.preview_image.src | append: ''
          if msrc contains fkey
            assign full = m.preview_image
          endif
        endfor
        if full != blank
          assign worn = full
        endif
      -%}
      <div class="dnr-dense__item" data-line="{{ line_d }}" data-colour="{{ colour }}" data-gender="{{ gender }}">
        <div class="dnr-dense__stage">
          <a class="dnr-dense__obj" href="{{ product.url }}">
            <span class="dnr-dense__pic">
              <img class="p" crossorigin="anonymous" src="{{ pic | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="1000">
              {%- if worn != blank -%}<img class="w{% if full != blank %} full{% endif %}" crossorigin="anonymous" src="{{ worn | image_url: width: 900 }}" alt="" loading="lazy" width="{{ worn.width }}" height="{{ worn.height }}">{%- endif -%}
            </span>
            <span class="dnr-dense__label"><b class="ty"><span class="tw"><span class="tx">{{ parts[1] }} · {{ colour }}</span></span></b><span class="ty"><span class="tw"><span class="tx">{{ gender }} · <span class="dnr-local-price">{{ product.price | money }}</span></span></span></span></span>
          </a>
          {%- liquid
            if line_d == 'air light'
              if gender == 'men'
                assign wt = '42g'
              else
                assign wt = '33g'
              endif
              assign l1 = 'opaque. nothing shows.'
              # 2026-10-20 gsm 표기 뺌 (전: 100% polyester · 80gsm)
              assign l2 = '100% polyester'
              assign l3 = wt | append: ' — lighter than a sip of water.'
            else
              assign l1 = 'mesh. air moves through.'
              assign l2 = '92% polyester · 8% spandex'
              assign l3 = 'open air, swift as breath.'
            endif
          -%}
          <div class="dnr-dense__desc" aria-label="{{ product.title | escape }}">
            <p class="h" data-t="{{ line_d }} — {{ colour }}"></p>{%- comment -%} 2026-10-20 제목에서 opaque/mesh 뺌 — 본문 첫 줄에 그대로 있음 {%- endcomment -%}
            <p data-t="{{ gender }} · {{ product.price | money | strip_html }}"></p>
            <p data-t="{{ l1 }}"></p>
            <p data-t="{{ l2 }}"></p>
            <p data-t="{{ l3 }}"></p>
            <p data-t="seams erased, strength kept."></p>
            <p data-t="&gt; view" data-href="{{ product.url }}"></p>
          </div>
        </div>
      </div>
    {%- endfor -%}
    {%- endfor -%}
    <div class="dnr-dense__all"><a href="/collections/all">see all</a></div>
  </div>
  <button type="button" class="dnr-dense__top" id="dnrTop" aria-label="맨 위로">↑ top</button>
</div>

<script>
