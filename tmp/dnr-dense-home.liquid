    const q = k.sc[j]; let R = q.R, G = q.G, B = q.B; if (reduce) return [R, G, B];
    if (q.light){ const f = .9 + .1*Math.sin(t*k.sp*.9 + k.ph) + .3*Math.pow(Math.max(0, Math.sin(t*k.sp*.5 + k.ph*2)), 30); return [R*f, G*f, B*f]; }
    if (q.refl){ const f = .88 + .22*Math.max(0, Math.sin(k.r*1.7 - t*1.6 + k.c*.35)) + .06*Math.sin(t*.9 + k.ph); return [R*f, G*f, B*f]; }
    if (q.wet){
