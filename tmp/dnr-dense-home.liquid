  }, IMG = {};
  const GLC = { day: [255, 255, 255], sunset: [255, 232, 178], night: [214, 216, 255] };
  // [위치 0~1, 낮, 노을, 밤] — 사이 구간은 부드럽게 섞음
  const MIX = [[0, 1, 0, 0], [.25, 1, 0, 0], [.37, 0, 1, 0], [.47, 0, 1, 0], [.59, 0, 0, 1], [.78, 0, 0, 1], [.88, 0, .75, .25], [.95, 1, 0, 0], [1, 1, 0, 0]];
  // 해 [위치, x, y(첫 화면 세로 비율), 세기] — 노을 그림 속 해 자리(데스크톱 64.5%·모바일 72%, 세로 8.5%)에 맞춰 내려앉음
  const SUNP = [[0, .40, .02, .55], [.25, .52, .02, .55], [.37, .62, .06, .9], [.45, .645, .085, 1], [.52, .66, .125, 0], [.84, .2, .125, 0], [.9, .24, .085, .9], [1, .40, .02, .55]];
  const sm3 = t => t*t*(3 - 2*t);
  function lerpKF(K, p){ let i = 0; while (i < K.length - 2 && p > K[i + 1][0]) i++; const A = K[i], B = K[i + 1], k = sm3(Math.min(1, Math.max(0, (p - A[0])/(B[0] - A[0])))); return A.map((v, j) => v + (B[j] - v)*k); }
  const FIX = { day: 0, sunset: .42, night: .68 }[TOD_Q];
  const loadImg = u => IMG[u] || (IMG[u] = new Promise(res => { const im = new Image(); im.onload = () => res(im); im.onerror = () => res(null); im.src = u; }));
  function sample(im, scene){
    // 그림을 칸 수로 줄여 칸마다 색. 첫 화면 비율에 맞게 가운데를 채움. 칸 종류(불빛·비친 빛·물·풀)는 시간대마다 따로
    const sc = Math.max(cols/im.naturalWidth, rows/im.naturalHeight), dw = im.naturalWidth*sc, dh = im.naturalHeight*sc;
    const mid = document.createElement('canvas'); mid.width = cols*3; mid.height = rows*3; const mx = mid.getContext('2d'); mx.imageSmoothingQuality = 'high';
    mx.drawImage(im, (cols - dw)/2*3, (rows - dh)/2*3, dw*3, dh*3);
    const sm = document.createElement('canvas'); sm.width = cols; sm.height = rows; const sx = sm.getContext('2d'); sx.imageSmoothingQuality = 'high';
    sx.drawImage(mid, 0, 0, cols, rows);
    let d; try { d = sx.getImageData(0, 0, cols, rows).data; } catch (e) { return null; }
    const SUN = scene === 'sunset', NIGHT = scene === 'night', out = [];
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++){
      const i = (r*cols + c)*4, R = d[i], G = d[i+1], B = d[i+2], L = (R*.3 + G*.59 + B*.11)/255;
