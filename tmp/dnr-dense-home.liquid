  <div class="dnr-dense__field" aria-hidden="true"><canvas id="dnrField"></canvas></div>
  <div class="dnr-dense__items">
    {%- for pass in (1..2) -%}
      {%- liquid
        if pass == 1
          assign want = 'air light'
        else
          assign want = 'air swift'
        endif
      -%}
    {%- for product in coll.products limit: 50 -%}
      {%- liquid
        assign parts = product.title | split: ' · '
        assign line_chk = parts[1] | downcase
        if line_chk != want
          continue
        endif
        assign pic = product.featured_image
        assign worn = blank
        for m in product.media
          assign msrc = m.preview_image.src | append: ''
          if msrc contains 'new_'
            if msrc contains '_b115' or msrc contains '_b215'
              assign pic = m.preview_image
            elsif msrc contains '_108' or msrc contains '_208'
              assign worn = m.preview_image
            endif
          endif
        endfor
        assign parts = product.title | split: ' · '
        assign gender = parts[2] | split: '(' | last | remove: ')'
        assign colour = parts[2] | split: ' (' | first
        assign line_d = parts[1] | downcase
        # 호버 사진(new_*_108/208)은 전신 사진을 잘라낸 것. 옆으로 비켜설 때는 같은 포즈의 전신 사진을 써서 위아래가 안 잘리게.
        # 원본 번호(2026-10-15 사진 대조): 남 al_cs 101 · al_hv 107 · as_cs 106 · as_hv 105 / 여 al_cs·al_hv·as_hv 207 · as_cs 201
        if line_d == 'air light'
          assign lc = 'al'
        else
          assign lc = 'as'
        endif
        if colour contains 'clear'
          assign cc = 'cs'
        else
          assign cc = 'hv'
        endif
        assign combo = lc | append: '_' | append: cc | append: '_' | append: gender
        case combo
          when 'al_cs_men'
            assign idx = '101'
          when 'al_hv_men'
            assign idx = '107'
          when 'as_cs_men'
            assign idx = '106'
          when 'as_hv_men'
            assign idx = '105'
          when 'as_cs_women'
            assign idx = '201'
          else
            assign idx = '207'
        endcase
        assign fkey = 'files/' | append: lc | append: '_' | append: cc | append: '_' | append: idx
        assign full = blank
        for m in product.media
          assign msrc = m.preview_image.src | append: ''
          if msrc contains fkey
            assign full = m.preview_image
          endif
        endfor
        if full != blank
          assign worn = full
        endif
      -%}
      <div class="dnr-dense__item" data-line="{{ line_d }}" data-colour="{{ colour }}" data-gender="{{ gender }}">
        <div class="dnr-dense__stage">
          <a class="dnr-dense__obj" href="{{ product.url }}">
            <span class="dnr-dense__pic">
              <img class="p" crossorigin="anonymous" src="{{ pic | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy" width="800" height="1000">
              {%- if worn != blank -%}<img class="w{% if full != blank %} full{% endif %}" crossorigin="anonymous" src="{{ worn | image_url: width: 900 }}" alt="" loading="lazy" width="{{ worn.width }}" height="{{ worn.height }}">{%- endif -%}
            </span>
            <span class="dnr-dense__label"><b class="ty"><span class="tw"><span class="tx">{{ parts[1] }} · {{ colour }}</span></span></b><span class="ty"><span class="tw"><span class="tx">{{ gender }} · <span class="dnr-local-price">{{ product.price | money }}</span></span></span></span></span>
          </a>
          {%- liquid
            if line_d == 'air light'
              if gender == 'men'
                assign wt = '42g'
              else
                assign wt = '33g'
              endif
              assign l1 = 'opaque. nothing shows.'
              # 2026-10-20 gsm 표기 뺌 (전: 100% polyester · 80gsm)
              assign l2 = '100% polyester'
              assign l3 = wt | append: ' — lighter than a sip of water.'
            else
              assign l1 = 'mesh. air moves through.'
              assign l2 = '92% polyester · 8% spandex'
              assign l3 = 'open air, swift as breath.'
            endif
          -%}
          <div class="dnr-dense__desc" aria-label="{{ product.title | escape }}">
            <p class="h" data-t="{{ line_d }} — {{ colour }}"></p>{%- comment -%} 2026-10-20 제목에서 opaque/mesh 뺌 — 본문 첫 줄에 그대로 있음 {%- endcomment -%}
            <p data-t="{{ gender }} · {{ product.price | money | strip_html }}"></p>
            <p data-t="{{ l1 }}"></p>
            <p data-t="{{ l2 }}"></p>
            <p data-t="{{ l3 }}"></p>
            <p data-t="seams erased, strength kept."></p>
            <p data-t="&gt; view" data-href="{{ product.url }}"></p>
          </div>
        </div>
      </div>
    {%- endfor -%}
    {%- endfor -%}
    <div class="dnr-dense__all"><a href="/collections/all">see all</a></div>
  </div>
  <button type="button" class="dnr-dense__top" id="dnrTop" aria-label="맨 위로">↑ top</button>
</div>

<script>
(function(){
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const INK = '#16191c', PAPER = '#f2f2f0', SHEET = '#f7f7f4', BLUE = '#1f5fd0', RED = '#e3412b';
  const fontFor = (fs, w) => `${w || 600} ${fs}px "IBM Plex Mono", monospace`;
  // 값 노이즈
  const hash = (x, y) => { let h = (x*374761393 + y*668265263) | 0; h = (h ^ (h >>> 13)) * 1274126177; return ((h ^ (h >>> 16)) >>> 0) / 4294967295; };
  const lerp = (a, b, t) => a + (b-a)*t, sm = t => t*t*(3-2*t);
  function vnoise(x, y){ const xi = Math.floor(x), yi = Math.floor(y), xf = x-xi, yf = y-yi;
    return lerp(lerp(hash(xi,yi), hash(xi+1,yi), sm(xf)), lerp(hash(xi,yi+1), hash(xi+1,yi+1), sm(xf)), sm(yf)); }
  const fbm = (x, y) => (vnoise(x,y)*.55 + vnoise(x*2.1,y*2.1)*.3 + vnoise(x*4.3,y*4.3)*.15);

  /* ---------- 첫 화면: 찢어진 종이 + 강가·흐르는 강·윤슬 (2026-10-21, v4 북한강 배경으로 되돌림) ----------
     장면 (u,v = 0..1). 강은 오른쪽 위에서 찢어진 가장자리 쪽 왼쪽 아래로 흘러 들어감 → 찢긴 틈의 파란 물과 이어짐.
     v4와 같은 그림. 글자 러너는 콜라주에 러너 조각이 있어 뺌. 트랙 배경 = sections/dnr-dense-home.v5_track.liquid */
  const cv = document.getElementById('dnrArt'), ctx = cv.getContext('2d');
  let W, H, dpr, fs, cw, ch, cols, rows, photo, paper, mask, rim, mctx, rctx, tearAt, glints = [], visible = true, heroDirty = true, compDirty = true, CELLS = [];
  const riverC = u => .50 + .20*(1-u) + .025*Math.sin(u*7);
  const riverHalf = u => .045 + .06*(1-u);
  const ridge = u => .16 + .07*Math.sin(u*4.2 + .6) + .035*Math.sin(u*11.3);
  const hill = (u, v) => Math.sin(u*9 + v*3) * .5 + fbm(u*6, v*6);
  // 칸 하나의 글자: 언덕(경사 방향 / \ | _), 갈대(| i l !), 앞쪽 풀(, ' ; " /). 반환 [글자, 종류(h 언덕·하늘 · g 풀 · r 강물), 강 가운데서 거리]
  function glyph(u, v, c, r){
    const rc = riverC(u), rh = riverHalf(u), dv = v - rc;
    if (Math.abs(dv) < rh) return ['', 'r', Math.abs(dv)/rh];                                 // 강물은 움직임 쪽
    const R = ridge(u);
    if (v < R) return hash(c, r) > .992 ? ['.', 'h'] : null;                                  // 하늘: 거의 빈 종이
    if (dv < 0){                                                                              // 강 건너편 언덕
      const toRiver = (rc - rh) - v;
      if (toRiver < .035) return ['Ii|l!'[Math.floor(hash(c,r)*5)], 'h'];                     // 물가 갈대
      const e = .004, h0 = hill(u, v), hx = hill(u+e, v) - h0, hy = hill(u, v+e) - h0;
      const shade = .35 + .65*Math.min(1, (v - R)/.25);
      if (hash(c, r+7) > shade*.95 + .1) return null;
      if (Math.abs(v - R) < .012) return ['_', 'h'];
      const k = ((Math.atan2(hy, hx) + Math.PI) / Math.PI * 4) | 0;                           // 경사 방향 → 글자
      return [['-','\\','|','/','-','\\','|','/','-'][k], 'h'];
    }
    const below = v - (rc + rh);                                                              // 이쪽 물가·풀밭
    if (below < .03) return ['~_-.'[Math.floor(hash(c,r)*4)], 'h'];
    if (hash(c, r+3) > Math.min(1, .25 + below*2.2)) return null;
    return [",';\"/\\|.,"[Math.floor(hash(c+1, r)*9)], 'g'];
  }
  // 포인트 색: 물결 글자의 일부만 파랑, 아주 드물게 빨강 → 전체 글자의 5% 미만
  const accent = (g, a, b) => { const h = hash(a*7 + 3, b*13 + 5); if ('_~-='.includes(g) && h > .93) return BLUE; if (h < .012) return RED; return INK; };
  function build(){
    const cssW = cv.clientWidth || document.documentElement.clientWidth; if (!cssW) return requestAnimationFrame(build);
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = cssW; H = Math.round(W * (W < 750 ? 1.45 : .56));
    cv.width = W*dpr; cv.height = H*dpr; cv.style.height = H + 'px';
    fs = W < 750 ? 8 : W < 1000 ? 9 : 10;
    ctx.font = fontFor(fs); cw = ctx.measureText('M').width || fs*.6; ch = fs*1.08;
    cols = Math.ceil(W/cw); rows = Math.ceil(H/ch);
    // 찢어진 선: 위 오른쪽 → 아래 왼쪽, 큰 굴곡 + 잔 톱니
    const base = W < 750 ? [.46, .20] : [.40, .24];
    tearAt = y => { const v = y/H; return W*(base[0] - (base[0]-base[1])*v) + W*.06*(fbm(v*3.1, 7.7) - .5)*2 + (hash(Math.floor(y/3), 91) - .5)*5; };
    const mk = s => { const c = document.createElement('canvas'); c.width = Math.round(W*s); c.height = Math.round(H*s); const x = c.getContext('2d'); return [c, x]; };
    // 파란 강물(찢긴 틈으로 보이는 사진 쪽)
    let wx; [photo, wx] = mk(dpr); wx.scale(dpr, dpr);
    const g = wx.createLinearGradient(0, 0, W*.5, H); g.addColorStop(0, '#2b6fd4'); g.addColorStop(.55, '#0f43a8'); g.addColorStop(1, '#0a2f86');
    wx.fillStyle = g; wx.fillRect(0, 0, W, H);
    for (let y=0;y<H;y+=2){ for (let x=0;x<W;x+=3){ const n = fbm(x*.006 - y*.002, y*.03); const f = fbm(x*.02 + y*.004, y*.11);
      const a = Math.max(0, n - .5)*1.4 + Math.max(0, f - .62)*1.6; if (a < .02) continue; wx.fillStyle = `rgba(214,232,255,${Math.min(.75, a).toFixed(3)})`; wx.fillRect(x, y, 3, 1.4); } }
    const img = wx.getImageData(0, 0, photo.width, photo.height); for (let i=0;i<img.data.length;i+=4){ const k = (Math.random()-.5)*18; img.data[i]+=k; img.data[i+1]+=k; img.data[i+2]+=k; } wx.putImageData(img, 0, 0);
    glints = []; for (let i=0;i<(W<750?140:260);i++){ const y = Math.random()*H, x = Math.random()*tearAt(y); if (fbm(x*.006 - y*.002, y*.03) < .46) continue; glints.push([x, y, Math.random()*6.28, .6 + Math.random()*1.8, 1 + Math.random()*2.2]); }
