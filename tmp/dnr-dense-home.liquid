  }
  function build(){
    const cssW = cv.clientWidth || document.documentElement.clientWidth; if (!cssW) return requestAnimationFrame(build);
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = cssW; H = Math.round(W * (W < 750 ? 1.45 : .56));
    cv.width = W*dpr; cv.height = H*dpr; cv.style.height = H + 'px';
    cols = W < 750 ? 40 : W < 1100 ? 80 : 106; cell = W/cols; rows = Math.ceil(H/cell);
    grain = [0, 1].map(() => { const c = document.createElement('canvas'); c.width = cv.width; c.height = cv.height; const x = c.getContext('2d');
      const id = x.createImageData(c.width, c.height), d = id.data;
      for (let i = 0; i < d.length; i += 4){ const v = Math.random(); const on = v > .5; d[i] = d[i+1] = d[i+2] = on ? 255 : 0; d[i+3] = (Math.abs(v - .5) * 2) * (on ? 34 : 12); }
