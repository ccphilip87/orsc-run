  /* 글자 표지: 1개 → 2개 → 1개 → 2개 번갈아 타자로 찍힘(사이 0.6~1.8초 랜덤, 2개일 땐 둘째가 1초 늦게). 다 찍힌 뒤에도 1.5~4초 랜덤 간격으로 1개·2개 번갈아 지웠다 다시 찍음 — 계속 움직임. 동작 줄이기면 처음부터 다 보임 */
  {
    const labs = [...document.querySelectorAll('.dnr-lab')].map(el => { const full = el.innerHTML.replace(/<br\s*\/?>/g, '\n').replace(/<[^>]+>/g, '').trim(); el.textContent = ''; const tx = document.createElement('i'); tx.className = 'tx'; el.appendChild(tx); return { el, tx, full }; });
    const shown = () => labs.filter(l => getComputedStyle(l.el).display !== 'none');
    const wait = ms => new Promise(r => setTimeout(r, ms));
    async function type(l){ l.el.classList.add('on', 'typing'); for (let i = 1; i <= l.full.length; i++){ l.tx.textContent = l.full.slice(0, i); await wait(38 + Math.random()*40); } l.el.classList.remove('typing'); l.el.classList.add('blink'); setTimeout(() => l.el.classList.remove('blink'), 1400); }
    async function erase(l){ l.el.classList.add('typing'); for (let i = l.full.length; i >= 0; i--){ l.tx.textContent = l.full.slice(0, i); await wait(14); } }
    if (reduce) labs.forEach(l => { l.tx.textContent = l.full; l.el.classList.add('on'); });
    else (async () => {
      const order = shown().sort(() => Math.random() - .5);
      order.splice(0, Math.round(order.length*.7)).forEach(l => { l.tx.textContent = l.full; l.el.classList.add('on'); });   // 처음부터 70%는 찍혀 있음(2026-10-21)
      await wait(700);
      let n = 1;                                                    // 1개 → 2개 → 1개 → 2개 … 번갈아, 사이는 0.6~1.8초 랜덤
      while (order.length){ const g = order.splice(0, n); n = 3 - n; await Promise.all(g.map((l, i) => wait(i*1000).then(() => type(l)))); await wait(600 + Math.random()*1200); }
      for (;;){ await wait(1500 + Math.random()*2500); if (!visible) continue;
        const pool = shown().sort(() => Math.random() - .5).slice(0, n); n = 3 - n;
        await Promise.all(pool.map(async (l, i) => { await wait(i*1000); await erase(l); await wait(250); await type(l); })); }
    })();
  }

  /* ---------- 콜라주: 조각이 다 준비되면 차례로 붙고, 데스크톱에서는 마우스를 따라 깊이별로 살짝 움직임 ---------- */
  const col = document.getElementById('dnrCollage'), stageEl = document.getElementById('dnrStage'), pcs = [...col.querySelectorAll('.dnr-pc')];
  Promise.all(pcs.map(im => im.decode ? im.decode().catch(() => {}) : Promise.resolve())).then(() => col.classList.add('go'));
  // 따라 움직임: 데스크톱은 마우스, 휴대폰은 문지르는 손가락 위치. 깊이(--d)가 클수록 많이 움직임
  let modelBusy = false;                                              // 모델이 클릭으로 흔들리는 동안 다른 조각은 멈춤
  const setPar = (mx, my) => { if (!modelBusy) pcs.forEach(p => { const d = +p.style.getPropertyValue('--d') || 0; p.style.setProperty('--px', (-mx*18*d).toFixed(1) + 'px'); p.style.setProperty('--py', (-my*12*d).toFixed(1) + 'px'); }); };
