    });
    /* 픽셀 판(2026-10-21): 모델이 물 위에 떠 있듯 하늘하늘 — 위아래 10~14px·옆 5~8px·기울기 0.6~1°, 느리고 서로 어긋난 주기 */
    FL.forEach(f => { if (!f.person) return; const sg = () => Math.random() < .5 ? -1 : 1;
      f.ax = (5 + Math.random()*3)*sg(); f.ay = (10 + Math.random()*4)*sg(); f.ar = (.6 + Math.random()*.4)*sg(); f.tx = 8 + Math.random()*2; f.ty = 5.5 + Math.random()*1.5; f.tr = 9 + Math.random()*2; });
    const model = FL.find(f => f.person);
