  }
  const labsEl = document.getElementById('dnrLabs'), woman = document.querySelector('.dnr-pc--woman'), man = document.querySelector('.dnr-pc--man');
  let inkNight = null;
  function hero(now){
    if (!CELLS || !grain.length) return; const t = (now || 0)/1000;
    if (!reduce && now - lastDraw < 80 && !heroDirty) return;             // 약 12fps
    lastDraw = now || 0; heroDirty = false;
    const p = FIX !== undefined ? FIX : reduce ? 0 : (t/CYCLE) % 1;
    const M = lerpKF(MIX, p), w = [M[1], M[2], M[3]];
    // 글자: 밤이 반 넘으면 밝게. 모델: 낮(동틀 녘~오후) 여자, 노을~밤 남자
    const night = w[2] > .5; if (night !== inkNight){ inkNight = night; labsEl.style.setProperty('--lab-ink', night ? '#f2f3fa' : '#16191c'); }
    const wo = p < .3 ? 1 : p < .38 ? 1 - sm3((p - .3)/.08) : p < .84 ? 0 : p < .92 ? sm3((p - .84)/.08) : 1;
    if (woman && man){ woman.style.opacity = wo.toFixed(3); man.style.opacity = (1 - wo).toFixed(3); }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const cw = Math.ceil(cell) + 1;
    for (const k of CELLS){
      let R = 0, G = 0, B = 0;
      for (let j = 0; j < 3; j++){ if (w[j] < .002) continue; const cc = cellColor(k, j, t); R += cc[0]*w[j]; G += cc[1]*w[j]; B += cc[2]*w[j]; }
      ctx.fillStyle = `rgb(${Math.min(255, R)|0},${Math.min(255, G)|0},${Math.min(255, B)|0})`; ctx.fillRect(Math.floor(k.c*cell), Math.floor(k.r*cell), cw, cw);
