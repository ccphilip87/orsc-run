    Promise.all(SCN.map(s => loadImg(SRCS[s][key]))).then(ims => {
      if (ims.some(im => !im) || cols !== want) return;
      const S = ims.map((im, j) => sample(im, SCN[j])); if (S.some(x => !x)) return;
