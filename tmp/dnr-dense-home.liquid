        if (j === 1){ const lane = Math.pow(.5 + .5*Math.sin(k.c*.21 - t*1.5 + (k.r % 4)*1.6), 5); tw = Math.min(1, tw*lane*(.35 + 1.4*k.nr) + lane*k.nr*q.s*.35); }
        const gl = GLC[SCN[j]]; R += (gl[0] - R)*tw; G += (gl[1] - G)*tw; B += (gl[2] - B)*tw; }
