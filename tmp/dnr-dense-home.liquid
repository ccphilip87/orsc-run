      const scx = Math.round(sxp*cols), scy = Math.round(SP[2]*rows), warm = w[1];
      const core = [255, 252 - 30*warm, 236 - 90*warm], halo = [255, 240 - 40*warm, 200 - 80*warm];
      for (let dy = -4; dy <= 4; dy++) for (let dx = -4; dx <= 4; dx++){
        const dd = Math.hypot(dx, dy*1.1), x = (scx + dx)*cell, y = (scy + dy)*cell; if (y < 0) continue;
        const a = dd <= 1.3 ? sa : dd <= 4 ? sa*.28*Math.pow(1 - (dd - 1.3)/2.7, 1.6) : 0; if (a <= .01) continue;
        const col = dd <= 1.3 ? core : halo; ctx.fillStyle = `rgba(${col[0]|0},${col[1]|0},${col[2]|0},${a.toFixed(3)})`; ctx.fillRect(Math.floor(x), Math.floor(y), cw, cw);
